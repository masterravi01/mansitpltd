---
import { addressLines, company } from '../data/site';

const facts = [
  { label: 'Company number', value: company.number },
  { label: 'Company type', value: company.type },
  { label: 'Status', value: company.status },
  { label: 'Incorporated', value: company.incorporated },
] as const;
---

<section id="company" class="bg-neutral py-14 md:py-16" aria-labelledby="company-heading">
  <div class="wrap">
    <h2 id="company-heading" class="text-lg font-bold text-forest">{company.legalName}</h2>
    <dl class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        facts.map((fact) => (
          <div>
            <dt class="text-sm text-muted">{fact.label}</dt>
            <dd class="mt-1 font-semibold">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="mt-8 grid gap-6 border-t border-ink/10 pt-6 md:grid-cols-2">
      <div>
        <h3 class="text-sm font-semibold text-muted">Registered office</h3>
        <address class="mt-2 not-italic leading-relaxed">
          {
            addressLines().map((line) => (
              <>
                {line}
                <br />
              </>
            ))
          }
        </address>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-muted">Business activity</h3>
        <p class="mt-2 font-semibold">{company.activity.name}</p>
        <p class="mt-1 text-sm text-muted">SIC {company.activity.code}</p>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-muted">Email</h3>
        <p class="mt-2">
          <a class="contact-link break-all" href={`mailto:${company.email}`}>{company.email}</a>
        </p>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-muted">Phone</h3>
        <p class="mt-2">
          <a class="contact-link" href={company.phoneHref}>{company.phoneDisplay}</a>
        </p>
      </div>
    </div>
  </div>
</section>
