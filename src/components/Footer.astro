---
import { formattedAddress, company, footerLinks } from '../data/site';

const year = new Date().getFullYear();
const onHome = Astro.url.pathname === '/';

function hrefFor(href: string) {
  if (href === '/') return onHome ? '#home' : '/';
  if (onHome && href.startsWith('/#')) return href.slice(1);
  return href;
}
---

<footer class="bg-forest text-white">
  <div class="wrap py-12 md:py-14">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="text-lg font-bold">{company.brandName}</p>
        <p class="mt-2 text-white/75">{company.tagline}</p>
      </div>
      <nav aria-label="Footer">
        <ul class="grid gap-2">
          {
            footerLinks.map((link) => (
              <li>
                <a class="text-sm text-white/80 no-underline hover:text-white" href={hrefFor(link.href)}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="text-sm leading-relaxed text-white/80">
        <p>{company.legalName}</p>
        <p>Company number: {company.number}</p>
        <p class="mt-3">
          <a class="contact-link break-all" href={`mailto:${company.email}`}>{company.email}</a>
        </p>
        <p>
          <a class="contact-link" href={company.phoneHref}>{company.phoneDisplay}</a>
        </p>
        <address class="mt-3 not-italic">{formattedAddress()}</address>
      </div>
    </div>
    <p class="mt-8 border-t border-white/15 pt-5 text-sm text-white/60">
      © {year} {company.legalName}. All rights reserved.
    </p>
  </div>
</footer>
